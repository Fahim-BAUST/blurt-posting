# Copy to .env for local runs (never commit .env). In GitHub, add these as Actions secrets.

# --- Blurt (required to post) ---
BLURT_USERNAME=your-blurt-username
# PRIVATE POSTING key only. Never use your owner/active key or master password.
BLURT_POSTING_KEY=<posting-key-from-your-secrets-manager>

# --- Text AI (at least one) ---
GEMINI_API_KEY=<from https://aistudio.google.com/apikey>
# GEMINI_MODEL=gemini-2.5-flash
# Optional fallback:
# GROQ_API_KEY=<from https://console.groq.com/keys>
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Image AI (optional; falls back to Pollinations.ai, which adds a small watermark) ---
# CF_ACCOUNT_ID=<cloudflare account id>
# CF_API_TOKEN=<cloudflare token with Workers AI permission>

# --- Optional tuning ---
# MIN_INTERVAL_HOURS=7
# MAX_INTERVAL_HOURS=9
# BLURT_CATEGORY=health
# BLURT_RPC_URLS=https://rpc.blurt.blog,https://rpc.beblurt.com
# POST_FOOTER=your own footer text, or "none" to remove it
